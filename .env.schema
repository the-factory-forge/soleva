# This env file uses @env-spec: https://varlock.dev/env-spec
#
# @defaultRequired=false @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# ----------

# Public origin used by the browser, SEO, and Better Auth.
# @required @type=url
VITE_BASE_URL=http://localhost:3000

# Optional analytics and marketing IDs. Empty means disabled.
# @optional
VITE_GA_MEASUREMENT_ID=
# @optional
VITE_GOOGLE_ADS_ID=
# @optional
VITE_ADS_CONVERSION_LABEL=
# Optional action-specific conversion labels.
# @optional
VITE_ADS_PHONE_LABEL=
# @optional
VITE_ADS_MAIL_LABEL=

# Optional login/intranet feature. Auth is enabled only when both values are set.
# @optional @sensitive @type=url
# @example="postgresql://postgres:password@localhost:5432/factory_soleva"
DATABASE_URL=

# Better Auth signing secret. Generate one with `vpr auth:secret`.
# @optional @sensitive
# @docs(https://www.better-auth.com/docs/reference/environment-variables)
BETTER_AUTH_SECRET=

# Optional GitHub OAuth application credentials.
# @optional
GITHUB_CLIENT_ID=
# @optional @sensitive
GITHUB_CLIENT_SECRET=

# Optional Google OAuth application credentials.
# @optional
GOOGLE_CLIENT_ID=
# @optional @sensitive
GOOGLE_CLIENT_SECRET=

# OAuth callbacks use <VITE_BASE_URL>/api/auth/callback/<provider>.
