# This env file uses @env-spec: https://varlock.dev/env-spec
# @defaultRequired=false @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# ----------

# Site
# @type=url @internal
PORTLESS_URL=
# @required @type=url
VITE_BASE_URL=fallback($PORTLESS_URL, "http://localhost:3000")

# Analytics
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_ADS_ID=
VITE_ADS_CONVERSION_LABEL=
VITE_ADS_PHONE_LABEL=
VITE_ADS_MAIL_LABEL=

# Intranet
# @required @sensitive @type=url
DATABASE_URL=
# @required @sensitive
# Also encrypts stored agent keys; retain this secret when deploying.
BETTER_AUTH_SECRET=

# Legacy GitHub settings (unused by login)
GITHUB_CLIENT_ID=
# @sensitive
GITHUB_CLIENT_SECRET=

# Google login
# @dynamic
GOOGLE_CLIENT_ID=
# @sensitive
GOOGLE_CLIENT_SECRET=

# Site
# @type=string(matches=regex("^[a-z0-9]+(?:-[a-z0-9]+)*$")) @dynamic
SITE_NAME=soleva

# Resend
# @sensitive
EMAIL_API_KEY=
# @dynamic
EMAIL_FROM=
