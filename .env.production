# ============================================================
# PRODUCTION - dockploy (soleva.the-corner.io)
# Paste this block (real values) into the app service environment.
# Build args (dockploy): VITE_* (inlined by Vite at build time)
# ============================================================

# ============ SITE (required) ============
VITE_BASE_URL=https://soleva.the-corner.io
CONTAINER_NAME=factory-soleva

# ============ FEATURE: ANALYTICS (GA4) - set in BUILD ARGS ============
VITE_GA_MEASUREMENT_ID=

# ============ FEATURE: MARKETING (Google Ads) - set in BUILD ARGS ============
VITE_GOOGLE_ADS_ID=

# ============ FEATURE: LOGIN / INTRANET ============
# Optional - enable = fill DATABASE_URL AND BETTER_AUTH_SECRET
# Postgres service in dockploy (project factories, app factory-db):
#   internal host = factories-factorydb-mlxmao (swarm-generated suffix)
#   user + database = factory_template (created by the dockploy DB form)
# Tables are created automatically on first boot (drizzle-kit migrate).
DATABASE_USER=factory_soleva
DATABASE_PASSWORD=<dockploy-db-password>
DATABASE_HOST=factories-factorydb-mlxmao
DATABASE_PORT=5432
DATABASE_NAME=factory_soleva
DATABASE_URL=

BETTER_AUTH_SECRET=


# ============ OAUTH2 (optional) ============
# Callback: https://factory-template.the-corner.io/api/auth/callback/<provider>
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
