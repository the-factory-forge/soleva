# Setup: README.md. Portless sets VITE_BASE_URL locally; set it in production.
SITE_NAME=soleva

# Optional analytics and Google Ads.
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_ADS_ID=
VITE_ADS_CONVERSION_LABEL=
VITE_ADS_PHONE_LABEL=
VITE_ADS_MAIL_LABEL=

# Legacy Compose defaults.
DATABASE_HOST=localhost

# Intranet: use an explicit PostgreSQL URL in production.
DATABASE_URL=exec("node scripts/local-database.mjs")
# Required: generate with `vpr auth:secret`.
BETTER_AUTH_SECRET=

# Optional Resend emails.
EMAIL_API_KEY=
EMAIL_FROM=

# Optional Google login; callback: /api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Legacy GitHub settings (unused by login).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
