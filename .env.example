# ============================================================
# The Corner Factory - site template configuration
# A feature is active only when its variables are filled in.
# Local setup: pnpm db:start + vpr db generate + vpr db migrate
# Production reference: dockploy environment editor (see README "Deployment")
# ============================================================

# ============ SITE (required) ============
VITE_BASE_URL=http://localhost:3000
CONTAINER_NAME=factory-soleva

# ============ FEATURE: ANALYTICS (GA4) ============
# Optional - empty = off
VITE_GA_MEASUREMENT_ID=

# ============ FEATURE: MARKETING (Google Ads) ============
# Optional - empty = off
VITE_GOOGLE_ADS_ID=

# ============ FEATURE: LOGIN / INTRANET ============
# Optional - enable = fill DATABASE_URL AND BETTER_AUTH_SECRET
# DATABASE_URL = postgresql://USER:PASSWORD@HOST:PORT/NAME
# One Postgres service per VPS, one database factory_<site> per site.
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=factory_soleva
DATABASE_URL=postgresql://postgres:password@localhost:5432/factory_soleva


BETTER_AUTH_SECRET=<run: pnpm auth:secret>

# ============ OAUTH2 (optional) ============
# Shown on /login when set. Callback: http://localhost:3000/api/auth/callback/<provider>
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
