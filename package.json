{
  "name": "soleva",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "portless run vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "start": "varlock run -- node src/intranet/db/preflight.ts && varlock run -- node .output/server/index.mjs",
    "lint": "vp lint --type-aware --type-check",
    "lint:fix": "vp lint --type-aware --type-check --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "db": "varlock run -- drizzle-kit",
    "deps": "pnpm dlx taze@latest -Ilw --maturity-period 3",
    "tanstack": "pnpm dlx @tanstack/cli@latest",
    "ui": "pnpm dlx shadcn@latest",
    "auth": "vpx auth@1.7.12",
    "auth:secret": "vpx auth@1.7.12 secret",
    "auth:generate": "varlock run -- vpx auth@1.7.12 generate --config ./src/intranet/auth/auth.ts --y --output ./.cache/auth.schema.generated.ts",
    "skills": "pnpm dlx skills@latest",
    "intent": "pnpm dlx @tanstack/intent@latest",
    "images:variants": "node scripts/generate-image-variants.mjs",
    "scrape:soleva": "node scripts/scrape-soleva-org.mjs",
    "db:start": "node scripts/local-database.mjs > /dev/null",
    "db:stop": "docker compose --env-file .env.local down",
    "db:reset": "docker compose --env-file .env.local down -v",
    "db:generate": "varlock run -- drizzle-kit generate",
    "db:migrate": "varlock run -- drizzle-kit migrate",
    "db:push": "varlock run -- drizzle-kit push --strict",
    "db:pull": "varlock run -- drizzle-kit pull",
    "db:studio": "varlock run -- drizzle-kit studio",
    "audit:migration": "node scripts/audit-migration.mjs",
    "start:e2e": "varlock run -- node .output/server/index.mjs",
    "test": "vp test",
    "test:e2e": "playwright test --pass-with-no-tests",
    "env:audit": "varlock audit --ignore .output",
    "env:load": "varlock load",
    "env:codegen": "varlock codegen",
    "prepare": "vp config && vp run env:codegen",
    "auth:admin": "varlock run -- vpx auth@1.7.12 create-admin --config ./src/intranet/auth/auth.ts",
    "test:e2e:intranet": "playwright test --config src/intranet/playwright.config.ts",
    "db:preflight": "varlock run -- node src/intranet/db/preflight.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/drizzle-adapter": "1.7.12",
    "@fontsource/montserrat": "5.3.0",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@varlock/vite-integration": "1.5.4",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "cnfast": "0.2.0",
    "drizzle-orm": "1.0.0-rc.5",
    "evlog": "2.33.1",
    "leaflet": "^1.9.4",
    "lucide-react": "1.61.0",
    "motion": "12.43.0",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.22.1",
    "varlock": "1.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-a11y": "0.2.2",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-plugin-query": "5.104.5",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query-devtools": "5.104.5",
    "@tanstack/react-router-devtools": "1.167.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "1.0.0-rc.5",
    "nitro": "3.0.260903-beta",
    "oxc-transform-react": "0.155.0",
    "portless": "0.15.6",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0",
  "generator": "create-mugnavo",
  "intent": {
    "skills": [
      "@tanstack/*",
      "drizzle-kit"
    ]
  }
}
